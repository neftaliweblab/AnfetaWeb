{
  "manifest_version": 3,
  "name": "ANFETA Web — Atajo global & WhatsApp Companion",
  "version": "1.1.6",
  "description": "Abre, enfoca o minimiza ANFETA Web, alterna entre sus módulos y permite sincronizar grupos de proyectos desde WhatsApp Web.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://anfeta-web.onrender.com/*",
    "https://*.onrender.com/*",
    "https://anfeta-web.vercel.app/*",
    "https://anfeta-web-iota.vercel.app/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp-sync.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://anfeta-web.onrender.com/*",
        "https://*.onrender.com/*",
        "https://anfeta-web.vercel.app/*",
        "https://anfeta-web-iota.vercel.app/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*"
      ],
      "js": ["anfeta-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Mostrar u ocultar ANFETA Web"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-anfeta": {
      "suggested_key": {
        "default": "Ctrl+Shift+8"
      },
      "description": "Mostrar u ocultar ANFETA Web",
      "global": true
    },
    "toggle-buscador-calendario": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "Alternar entre Buscador y Calendario en ANFETA"
    },
    "next-module": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Cambiar al siguiente módulo en ANFETA"
    }
  }
}
