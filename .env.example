# ANFETA · Configuración del servidor (no publicar credenciales en NEXT_PUBLIC_*)
NOTION_TOKEN=
# Base de datos compartida con la integración; se consulta su esquema real.
NOTION_DATABASE_ID=
# Solo para propiedades Responsable de tipo people: JSON usuario -> ID de Notion.
NOTION_PERSON_IDS={}
# Token Dropbox con files.content.write; requerido en Vercel.
DROPBOX_ACCESS_TOKEN=
# En Windows sin token de nube se conserva la carpeta de Dropbox sincronizada.
DROPBOX_PATH=
# Resumen ejecutivo: Groq en producción, Ollama como alternativa local.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=llama3.2
PORT=3000
